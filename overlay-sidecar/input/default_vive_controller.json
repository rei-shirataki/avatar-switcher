{
  "action_manifest_version": 1,
  "controller_type": "vive_controller",
  "description": "AvatarSwitcher's default bindings for Vive controllers",
  "interaction_profile": "",
  "name": "AvatarSwitcher Default Bindings",
  "options": {},
  "category": "steamvr_input",
  "alias_info": {},
  "app_key": "com.rei-shirataki.avatar-switcher.overlay",
  "bindings": {
    "/actions/hidden": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/hidden/in/overlayinteract"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "parameters": {
            "haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/hidden/in/overlayinteract"
            }
          }
        }
      ]
    }
  }
}
