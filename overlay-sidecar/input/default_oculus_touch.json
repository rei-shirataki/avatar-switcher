{
  "action_manifest_version": 1,
  "controller_type": "oculus_touch",
  "description": "AvatarSwitcher's default bindings for Oculus controllers",
  "interaction_profile": "",
  "name": "AvatarSwitcher Default Bindings",
  "options": {},
  "category": "steamvr_input",
  "alias_info": {},
  "app_key": "com.rei-shirataki.avatar-switcher.overlay",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/main/in/overlayinteract"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "parameters": {
            "haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/main/in/overlayinteract"
            }
          }
        }
      ]
    },
    "/actions/toggle": {
      "sources": [
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/toggle/in/openoverlay"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/toggle/in/openoverlay"
            }
          }
        }
      ]
    }
  }
}
