{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AvatarSwitcher",
  "version": "0.1.0",
  "identifier": "com.rei-shirataki.avatar-switcher",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npx ng build overlay-ui",
    "frontendDist": "../dist/avatar-switcher/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AvatarSwitcher",
        "width": 980,
        "height": 660,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "rei-shirataki",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/overlay-ui/browser": "overlay-ui"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Japanese"],
        "installMode": "currentUser"
      }
    }
  }
}
